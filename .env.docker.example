# Must be reachable by users' browsers; Docker service names are not public DNS.
# This is embedded during the build. Rebuild when changing the API URL.
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
# Internal backend URL for the image proxy; this is never sent to browsers.
API_URL=http://backend:4000/api/v1
BACKEND_NETWORK=magnificat-backend
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
FRONTEND_NETWORK=magnificat-frontend
